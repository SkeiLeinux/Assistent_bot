# Шаблон .env — скопировать в `.env` и заполнить. Сам `.env` в git не хранится.
# Имена ключей и дефолты — SSOT в app/config.py.
# На VPS `.env` обновляется РУКАМИ при деплое (docs/05_implementation/deploy-mvp-vps-runbook.md §4).

# ── Обязательное ────────────────────────────────────────────────────────────
BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./life_manager.db
ALLOWED_USER_IDS_RAW=
ADMIN_TELEGRAM_ID=
# Публичный HTTPS-URL мини-апы; без него кнопка мини-апы в боте не появится.
WEBAPP_URL=

# ── Смоук выкатки (scripts/smoke.py) — только на машине разработчика ────────
# Токен, которым смоук подписывает initData. Задавать, если BOT_TOKEN выше — от
# ТЕСТОВОГО бота (так на ноутбуке С.: на тестовом отлаживается UI мини-апы).
# Иначе прод отвечает 401 на все кейсы при живом /health.
# В прод-`.env` поле НЕ нужно: дефолт None, смоук на VPS не запускается.
SMOKE_BOT_TOKEN=

# ── LLM-провайдер расчёта КБЖУ (ADR-0017 §16) ───────────────────────────────
# Ключ прод-маршрута. Провайдер по умолчанию — OpenAI (llm_base_url), модель
# gpt-5.4-mini, поэтому значение совпадает с OPENAI_API_KEY ниже. Разными они
# станут, если llm_base_url укажет на другого OpenAI-совместимого провайдера.
LLM_API_KEY=

# ── Отказоустойчивость LLM (ADR-0018) — все дефолты рабочие, задавать НЕ нужно ─
# Вторичный таргет: тот же вендор, тот же LLM_API_KEY, другая модель. Отдельного
# ключа у него нет намеренно — вариант B ADR-0018 не предполагает второго вендора.
#   LLM_FALLBACK_VISION_MODEL=gpt-5.4
#   LLM_TIMEOUT_S=20.0
#   LLM_RETRY_429=2
# Guard присутствия модели (при старте + раз в сутки). Выключать только если
# провайдер не отдаёт /v1/models — он и был бы тем механизмом, который заметил
# бы снятие модели раньше пользователя (инцидент 17.07.2026).
#   LLM_GUARD_ENABLED=true
#   LLM_GUARD_INTERVAL_S=86400

# ── Ключи для замера eval (tests/eval/run_eval.py), в проде не используются ──
# Объявлены в config.py, потому что pydantic-settings запрещает лишние ключи
# в .env (extra_forbidden) — без объявления бот не стартует.
#
# OPENAI_API_KEY задавать НЕ нужно: раннер берёт прод-ключ из LLM_API_KEY, если
# этот пуст. Дублировать один секрет двумя именами — не конфигурация, а ловушка:
# копии рано или поздно разъезжаются. Заполнять только если под замер нужна
# ОТДЕЛЬНАЯ квота/биллинг — тогда этот ключ имеет приоритет.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
