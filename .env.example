# Шаблон .env — скопировать в `.env` и заполнить. Сам `.env` в git не хранится.
# Имена ключей и дефолты — SSOT в app/config.py.
# На VPS `.env` обновляется РУКАМИ при деплое (docs/05_implementation/deploy-mvp-vps-runbook.md §4).

# ── Обязательное ────────────────────────────────────────────────────────────
BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./life_manager.db
ALLOWED_USER_IDS_RAW=
ADMIN_TELEGRAM_ID=
# Публичный HTTPS-URL мини-апы; без него кнопка мини-апы в боте не появится.
WEBAPP_URL=

# ── LLM-провайдер расчёта КБЖУ (ADR-0017 §16) ───────────────────────────────
# Ключ прод-маршрута. Провайдер по умолчанию — OpenAI (llm_base_url), модель
# gpt-5.4-mini, поэтому значение совпадает с OPENAI_API_KEY ниже. Разными они
# станут, если llm_base_url укажет на другого OpenAI-совместимого провайдера.
LLM_API_KEY=

# ── Ключи для замера eval (tests/eval/run_eval.py), в проде не используются ──
# Объявлены в config.py, потому что pydantic-settings запрещает лишние ключи
# в .env (extra_forbidden) — без объявления бот не стартует.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
