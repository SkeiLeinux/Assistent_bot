<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_reminder-lifecycle" targetNamespace="http://assistent-bot/bpmn">
  <bpmn:process id="Proc_reminder-lifecycle" name="Жизненный цикл напоминания" isExecutable="false">
    <bpmn:startEvent id="s" name="Партнёр создаёт напоминание (ACTIVE)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="tick" name="Планировщик: тик — выбрать созревшие">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Есть созревшие?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="eWait" name="Нет — ждать след. тик">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="claim" name="Система: транзакционный claim (один push)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="В окне misfire-грейса (3 ч)?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="deliver" name="Система: last_fired_at=now; доставка через Notifications (push ✅/⏰)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="grec" name="recurrence?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="eDone" name="DONE (next_fire_at=NULL)">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="adv" name="Система: advance next_fire_at; статус ACTIVE">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="eReque" name="Снова в пуле (ACTIVE)">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gmiss" name="recurrence? (просрочено сверх грейса)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="missF" name="Система: продвинуть к ближайшему будущему слоту; ACTIVE">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="eReque2" name="Снова в пуле (ACTIVE)">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="eMissed" name="MISSED (одноразовое)">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s2" name="Партнёр нажал кнопку в push">
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="greact" name="Реакция?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ack" name="Система: ack — одноразовое→DONE / повтор→подтвердить (расписание не трогает)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="eAck" name="Подтверждено">
      <bpmn:incoming>f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="snooze" name="Система: snooze — next_fire_at=now+N, ACTIVE">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="eSnooze" name="Отложено (ACTIVE)">
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="tick" />
    <bpmn:sequenceFlow id="f2" sourceRef="tick" targetRef="g1" />
    <bpmn:sequenceFlow id="f3" name="нет" sourceRef="g1" targetRef="eWait" />
    <bpmn:sequenceFlow id="f4" name="да" sourceRef="g1" targetRef="claim" />
    <bpmn:sequenceFlow id="f5" sourceRef="claim" targetRef="g2" />
    <bpmn:sequenceFlow id="f6" name="в окне" sourceRef="g2" targetRef="deliver" />
    <bpmn:sequenceFlow id="f7" name="сверх грейса" sourceRef="g2" targetRef="gmiss" />
    <bpmn:sequenceFlow id="f8" sourceRef="deliver" targetRef="grec" />
    <bpmn:sequenceFlow id="f9" name="none" sourceRef="grec" targetRef="eDone" />
    <bpmn:sequenceFlow id="f10" name="daily/weekly/interval" sourceRef="grec" targetRef="adv" />
    <bpmn:sequenceFlow id="f11" sourceRef="adv" targetRef="eReque" />
    <bpmn:sequenceFlow id="f12" name="none" sourceRef="gmiss" targetRef="eMissed" />
    <bpmn:sequenceFlow id="f13" name="daily/weekly/interval" sourceRef="gmiss" targetRef="missF" />
    <bpmn:sequenceFlow id="f14" sourceRef="missF" targetRef="eReque2" />
    <bpmn:sequenceFlow id="f15" sourceRef="s2" targetRef="greact" />
    <bpmn:sequenceFlow id="f16" name="✅ ack" sourceRef="greact" targetRef="ack" />
    <bpmn:sequenceFlow id="f17" name="⏰ snooze" sourceRef="greact" targetRef="snooze" />
    <bpmn:sequenceFlow id="f18" sourceRef="ack" targetRef="eAck" />
    <bpmn:sequenceFlow id="f19" sourceRef="snooze" targetRef="eSnooze" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Proc_reminder-lifecycle">
    <bpmndi:BPMNPlane id="BPMNPlane_Proc_reminder-lifecycle" bpmnElement="Proc_reminder-lifecycle">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tick_di" bpmnElement="tick">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eWait_di" bpmnElement="eWait">
        <dc:Bounds x="507" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="claim_di" bpmnElement="claim">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true">
        <dc:Bounds x="650" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deliver_di" bpmnElement="deliver">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grec_di" bpmnElement="grec" isMarkerVisible="true">
        <dc:Bounds x="950" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eDone_di" bpmnElement="eDone">
        <dc:Bounds x="1107" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gmiss_di" bpmnElement="gmiss" isMarkerVisible="true">
        <dc:Bounds x="1250" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eMissed_di" bpmnElement="eMissed">
        <dc:Bounds x="1407" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_di" bpmnElement="s2">
        <dc:Bounds x="57" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="greact_di" bpmnElement="greact" isMarkerVisible="true">
        <dc:Bounds x="200" y="325" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ack_di" bpmnElement="ack">
        <dc:Bounds x="325" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eAck_di" bpmnElement="eAck">
        <dc:Bounds x="507" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="adv_di" bpmnElement="adv">
        <dc:Bounds x="1075" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eReque_di" bpmnElement="eReque">
        <dc:Bounds x="1257" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="missF_di" bpmnElement="missF">
        <dc:Bounds x="1375" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eReque2_di" bpmnElement="eReque2">
        <dc:Bounds x="1557" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="snooze_di" bpmnElement="snooze">
        <dc:Bounds x="325" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eSnooze_di" bpmnElement="eSnooze">
        <dc:Bounds x="507" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="507" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="575" y="210" />
        <di:waypoint x="650" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="700" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="675" y="235" />
        <di:waypoint x="675" y="280" />
        <di:waypoint x="1275" y="280" />
        <di:waypoint x="1275" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="950" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="1000" y="210" />
        <di:waypoint x="1107" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="975" y="235" />
        <di:waypoint x="975" y="350" />
        <di:waypoint x="1075" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1407" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13">
        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1350" y="210" />
        <di:waypoint x="1350" y="280" />
        <di:waypoint x="1350" y="280" />
        <di:waypoint x="1350" y="350" />
        <di:waypoint x="1375" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15">
        <di:waypoint x="93" y="350" />
        <di:waypoint x="200" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_di" bpmnElement="f16">
        <di:waypoint x="250" y="350" />
        <di:waypoint x="325" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f17_di" bpmnElement="f17">
        <di:waypoint x="225" y="375" />
        <di:waypoint x="225" y="490" />
