flowchart LR
  P(["👤 Партнёр"])
  TG(["✈️ Telegram"])

  subgraph SYS["Identity & Sharing"]
    direction TB
    UC1(["Войти в Mini App<br/>(валидация initData)"])
    UC2(["Создать семью"])
    UC3(["Выпустить / перевыпустить инвайт"])
    UC4(["Вступить по коду"])
