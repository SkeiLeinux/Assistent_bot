<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_e2-ssot-transition" targetNamespace="http://assistent-bot/bpmn">
  <bpmn:process id="Proc_e2-ssot-transition" name="E2 · Переход SSOT: таблица → транзакции (кандидат, ADR-0007)" isExecutable="false">
    <bpmn:startEvent id="s" name="Старт E2">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="par" name="Параллельный период: транзакции в боте + таблица как раньше">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g" name="Сверка месяца: Σ транзакций ≈ таблица?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix" name="Партнёр: разбор причин (забытые траты? канал?) → правки привычек/категорий">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="arch" name="Система: таблица → архив; Import ACL → консервация (код остаётся, не зовётся)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ritual" name="Партнёр (Катя): экспорт периода (xlsx) из бота (F2.6)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="eGate" name="Выход-гейт E2">
      <bpmn:incoming>f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="par" />
    <bpmn:sequenceFlow id="f2" sourceRef="par" targetRef="g" />
    <bpmn:sequenceFlow id="f3" name="расхождения" sourceRef="g" targetRef="fix" />
    <bpmn:sequenceFlow id="f4" name="сходится N месяцев" sourceRef="g" targetRef="arch" />
    <bpmn:sequenceFlow id="f5" sourceRef="fix" targetRef="par" />
    <bpmn:sequenceFlow id="f6" sourceRef="arch" targetRef="ritual" />
    <bpmn:sequenceFlow id="f7" sourceRef="ritual" targetRef="eGate" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Proc_e2-ssot-transition">
    <bpmndi:BPMNPlane id="BPMNPlane_Proc_e2-ssot-transition" bpmnElement="Proc_e2-ssot-transition">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="par_di" bpmnElement="par">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_di" bpmnElement="g" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fix_di" bpmnElement="fix">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arch_di" bpmnElement="arch">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ritual_di" bpmnElement="ritual">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eGate_di" bpmnElement="eGate">
        <dc:Bounds x="807" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="525" y="110" />
        <di:waypoint x="525" y="140" />
        <di:waypoint x="225" y="140" />
        <di:waypoint x="225" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="575" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="807" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
