<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_e3-huawei-import" targetNamespace="http://assistent-bot/bpmn">
  <bpmn:process id="Proc_e3-huawei-import" name="E3 · Здоровье: vision-разбор скринов (Huawei-zip отклонён #16)" isExecutable="false">
    <bpmn:startEvent id="s" name="Напоминание-пресет: «сними скрины тренировки/сна» (раз в 1–2 нед)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="h2" name="Партнёр: делает скрины экранов Huawei Health (тренировка · сон · шаги · вес)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="h3" name="Партнёр: загружает скрины в Mini App (мультифото)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="b1" name="Система: vision-LLM analyze — распознаёт показатели на скринах">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="b2" name="Система: нормализация → Measurement / Workout (с провенансом скрина)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="h4" name="Партнёр: confirm — проверяет/правит распознанное">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g" name="Пересечение с ручными записями?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="dedup" name="Система: дедупликация по ADR-0008 (источник-приоритет)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="up" name="Система: save — идемпотентный upsert по периодам">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="destroy" name="Система: скрины уничтожаются (медданные не храним сырьём)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="h7" name="Партнёр: смотрит отчёт импорта (новые периоды, конфликты)">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="eDone" name="Готово">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="h2" />
    <bpmn:sequenceFlow id="f2" sourceRef="h2" targetRef="h3" />
    <bpmn:sequenceFlow id="f3" sourceRef="h3" targetRef="b1" />
    <bpmn:sequenceFlow id="f4" sourceRef="b1" targetRef="b2" />
    <bpmn:sequenceFlow id="f5" sourceRef="b2" targetRef="h4" />
    <bpmn:sequenceFlow id="f6" sourceRef="h4" targetRef="g" />
    <bpmn:sequenceFlow id="f7" name="да" sourceRef="g" targetRef="dedup" />
    <bpmn:sequenceFlow id="f8" name="нет" sourceRef="g" targetRef="up" />
    <bpmn:sequenceFlow id="f9" sourceRef="dedup" targetRef="up" />
    <bpmn:sequenceFlow id="f10" sourceRef="up" targetRef="destroy" />
    <bpmn:sequenceFlow id="f11" sourceRef="destroy" targetRef="h7" />
    <bpmn:sequenceFlow id="f12" sourceRef="h7" targetRef="eDone" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Proc_e3-huawei-import">
    <bpmndi:BPMNPlane id="BPMNPlane_Proc_e3-huawei-import" bpmnElement="Proc_e3-huawei-import">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="57" y="52" width="36" height="36" />
